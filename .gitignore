# Isot data-aineistot ja tuotetut ruudut eivät kuulu versionhallintaan.
data/
tiles/

# Generoidut testivektorit. itu_vectors.json sisältää ITU-R SG3:n
# mittausprofiileja joiden levitysoikeutta ei ole selvitetty — ei repoon.
core/tests/vectors.json
core/tests/itu_vectors.json

